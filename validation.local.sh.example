# 首次部署时用编辑器将此文件另存为根目录 validation.local.sh，并修改实际路径。
# 该文件会自动同步到所有节点；配置应适用于各节点，必要时可按 hostname 分支。
TILEXR_CANN_ENV_SCRIPT=/path/to/cann-9.1.0/set_env.sh
ASCEND_DRIVER_PATH=/usr/local/Ascend/driver
TILEXR_VALIDATION_HOSTFILE=hostfile
TILEXR_VALIDATION_SSH_USER=""
TILEXR_VALIDATION_JOBS=4
TILEXR_VALIDATION_TIMEOUT=180
TILEXR_VALIDATION_BUILD_MODE=production
# 第二个提交点使用 ep-sdedup-p1-empty-kernel，第三个使用 ep-sdedup-p1-dry-run，仍执行相同七步。
# 使用完整名称，不带 Markdown 反引号；本文件保存为 LF 换行。
TILEXR_VALIDATION_CHECKPOINT=ep-sdedup-p1-abi-host
# 第四个检查点使用 ep-sdedup-p1-chain-single。将下行示例 IP 替换为首节点可跨机访问的 IPv4 后启用。
# export TILEXR_COMM_ID=192.0.2.11:10177
# Host barrier 默认使用同一 IP、端口 +97；需要指定时启用下行。
# export TILEXR_DEMO_BARRIER_ADDR=192.0.2.11:10274
# 单轮空 launch 默认参数；需要调整时启用对应行，仍沿用七步入口。
# export TILEXR_VALIDATION_BS=256
# export TILEXR_VALIDATION_H=7168
# export TILEXR_VALIDATION_TOPK=6
# export TILEXR_VALIDATION_MOE_EXPERT_NUM=384
# export TILEXR_VALIDATION_DTYPE=bf16
# export TILEXR_VALIDATION_BLOCK_DIM=auto
# 第五个检查点使用 ep-sdedup-p1-chain-multi，仅运行 Dispatch 单算子。
# 同一 stream 连续提交，整批结束后才同步和 Host barrier。
# functional 默认 loops=1/warmup=0；performance、breakdown 默认 loops=50/warmup=50。
# TILEXR_VALIDATION_RUN_MODE=functional
# TILEXR_VALIDATION_LOOPS=1
# TILEXR_VALIDATION_WARMUP=0
# performance 使用 CANN 的 msprof；不在 PATH 时填写可执行文件绝对路径。
# TILEXR_VALIDATION_MSPROF=msprof
