# 一次性环境配置：保存为 validation.local.sh，环境变化时才修改。
# 不填写服务器数、专家数、模式、轮次或 shape；由 run.sh 参数指定。
# 各节点路径不同时可按 hostname 分支；请使用 LF 换行。
TILEXR_CANN_ENV_SCRIPT=/path/to/cann-9.1.0/set_env.sh
ASCEND_DRIVER_PATH=/usr/local/Ascend/driver
TILEXR_VALIDATION_HOSTFILE=hostfile
# hostfile 每行一个服务器 IPv4；sync 分发全部，run.sh -n N 使用前 N 台。
TILEXR_VALIDATION_SSH_USER=""
TILEXR_VALIDATION_PYTHON=python3
TILEXR_VALIDATION_JOBS=4
TILEXR_VALIDATION_MSPROF=msprof
# 修改为首节点可跨机访问的实际 IPv4。
TILEXR_COMM_ID=192.0.2.11:10177
# 可省略：默认同一 IP、端口 +97。
# TILEXR_DEMO_BARRIER_ADDR=192.0.2.11:10274
# 需要额外动态库时，按环境实际路径配置：
# export LD_LIBRARY_PATH="${LD_LIBRARY_PATH:+${LD_LIBRARY_PATH}:}/path/to/dependencies/lib"
