foreach(required
    TILEXR_KERNEL_BINARY
    TILEXR_KERNEL_EMBED_CPP
    TILEXR_KERNEL_DATA_SYMBOL
    TILEXR_KERNEL_SIZE_SYMBOL)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()

if(NOT EXISTS "${TILEXR_KERNEL_BINARY}")
    message(FATAL_ERROR "AICore binary not found: ${TILEXR_KERNEL_BINARY}")
endif()
if(NOT TILEXR_KERNEL_DATA_SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$" OR
   NOT TILEXR_KERNEL_SIZE_SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Embedded binary symbols must be C identifiers")
endif()

file(SIZE "${TILEXR_KERNEL_BINARY}" binarySize)
file(WRITE "${TILEXR_KERNEL_EMBED_CPP}" "/* Generated by embed_aicore_kernel.cmake. */
#include <cstddef>

extern \"C\" {
extern const std::size_t ${TILEXR_KERNEL_SIZE_SYMBOL} = ${binarySize};
}

asm(R\"(
.section .rodata, \"a\", @progbits
.balign 16
.global ${TILEXR_KERNEL_DATA_SYMBOL}
.type ${TILEXR_KERNEL_DATA_SYMBOL}, @object
${TILEXR_KERNEL_DATA_SYMBOL}:
.incbin \"${TILEXR_KERNEL_BINARY}\"
${TILEXR_KERNEL_DATA_SYMBOL}End:
.size ${TILEXR_KERNEL_DATA_SYMBOL}, ${TILEXR_KERNEL_DATA_SYMBOL}End - ${TILEXR_KERNEL_DATA_SYMBOL}
.previous
)\");
")
