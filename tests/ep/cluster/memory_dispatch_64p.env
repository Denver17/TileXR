# Fixed topology and bootstrap endpoints for the current 8-node, 64-NPU environment.
TILEXR_EP_CLUSTER_RANK_SIZE=64
TILEXR_EP_CLUSTER_COMM_ID=141.61.94.18:10077
TILEXR_EP_CLUSTER_BARRIER_ADDR=141.61.94.18:10174
# Use "auto" for all device Vector Cores, or set an integer such as 48.
TILEXR_EP_CLUSTER_BLOCK_DIM=64
# Change these values for each DeepEP memory dispatch test case.
TILEXR_EP_CLUSTER_BS=256
TILEXR_EP_CLUSTER_H=5120
TILEXR_EP_CLUSTER_TOPK=6
TILEXR_EP_CLUSTER_MOE_EXPERT_NUM=128
TILEXR_EP_CLUSTER_DTYPE=bf16
TILEXR_EP_CLUSTER_QUANT_MODE=4
TILEXR_EP_CLUSTER_MXFP8_FORMAT=e4m3
TILEXR_EP_CLUSTER_ACTIVE_MASK_TYPE=none
TILEXR_EP_CLUSTER_EXPERT_MODE=uniform
TILEXR_EP_CLUSTER_EXPERT_SEED=1

# Correctness and performance controls.
TILEXR_EP_CLUSTER_CORRECTNESS_LOOPS=1
TILEXR_EP_CLUSTER_WARMUP=50
TILEXR_EP_CLUSTER_PERF_LOOPS=150
TILEXR_EP_CLUSTER_TIMEOUT_SECONDS=300
