# Empty overrides preserve the defaults in the shared Host/kernel headers.
set(TILEXR_EP_SERVER_DEDUP_SEND_CORE_NUM "" CACHE STRING "Dispatch send cores (16/24/32/40/48)")
set(TILEXR_EP_SERVER_DEDUP_COMBINE_SEND_CORE_NUM "" CACHE STRING "Combine send cores (16/24/32/40/48/56)")
set(TILEXR_EP_CORE_DEFINITIONS)
foreach(operator IN ITEMS DISPATCH COMBINE)
    if(operator STREQUAL "DISPATCH")
        set(variable TILEXR_EP_SERVER_DEDUP_SEND_CORE_NUM)
        set(allowed 16 24 32 40 48)
    else()
        set(variable TILEXR_EP_SERVER_DEDUP_COMBINE_SEND_CORE_NUM)
        set(allowed 16 24 32 40 48 56)
    endif()
    if(NOT "${${variable}}" STREQUAL "")
        if(NOT "${${variable}}" IN_LIST allowed)
            message(FATAL_ERROR "Invalid ${variable}=${${variable}}; expected one of ${allowed}")
        endif()
        # Asymmetric module tests deliberately override the package's Combine split.
        if(operator STREQUAL "COMBINE")
            list(APPEND TILEXR_EP_CORE_DEFINITIONS
                "${variable}=$<IF:$<BOOL:$<TARGET_PROPERTY:TILEXR_TEST_COMBINE_SEND_CORES>>,$<TARGET_PROPERTY:TILEXR_TEST_COMBINE_SEND_CORES>,${${variable}}>")
        else()
            list(APPEND TILEXR_EP_CORE_DEFINITIONS "${variable}=${${variable}}")
        endif()
    endif()
endforeach()
